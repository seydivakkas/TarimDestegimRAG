# App Configuration
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=sqlite:///./data/tarim_destek.db

# Storage Paths
RAW_DATA_PATH=./data/raw
NORMALIZED_DATA_PATH=./data/normalized
INDEX_PATH=./data/indexes

# Embedding
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Admin endpoints (disabled when unset; do not commit an actual secret)
# TARIM_RAG_ADMIN_API_KEY=replace-with-long-random-secret

# Allowed browser origins (comma-separated; avoid "*")
TARIM_RAG_CORS_ORIGINS=http://localhost:7860,http://127.0.0.1:7860
